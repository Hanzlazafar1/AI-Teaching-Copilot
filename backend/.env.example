# ---------------------------------------------------------------------------
# Backend configuration. Copy this file to `.env` and fill in your own key.
#
#   cp .env.example .env
#
# `.env` is gitignored. NEVER commit real credentials.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# LLM Provider Selection: "openrouter" or "openai"
# Switch easily between OpenRouter and OpenAI by changing this setting:
LLM_PROVIDER=openrouter

# OpenRouter API key (used when LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=

# OpenAI API key (used when LLM_PROVIDER=openai, or as fallback)
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Models — these are the CURRENT production defaults. You do not need to set
# them; they are listed so you know what is actually running.
#
# Generation runs on the flagship model; query-understanding and the quality
# judge run on the cheaper sibling, because they execute on EVERY turn.
# ---------------------------------------------------------------------------
# OPENAI_GENERATION_MODEL=gpt-5.4
# OPENAI_QUERY_MODEL=gpt-5.4-mini
# OPENAI_JUDGE_MODEL=gpt-5.4-mini

# The embedding model. WARNING: changing this invalidates the entire search
# index — you would have to rebuild it. See docs/SETUP.md.
# OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# ---------------------------------------------------------------------------
# Optional: route through a proxy or an alternative provider.
#
# LEAVE THIS COMMENTED OUT unless you genuinely mean to use one.
# An EMPTY value is worse than an absent one: the OpenAI client library reads
# this variable directly and honours "" as a real base address, which fails on
# the very first call. There is a defensive scrub for exactly this, but do not
# rely on it.
# ---------------------------------------------------------------------------
# OPENAI_BASE_URL=

# ---------------------------------------------------------------------------
# Behaviour tuning. All optional; defaults shown.
# ---------------------------------------------------------------------------
# ROUTE_TIMEOUT_SECONDS=90.0     # hard deadline for one turn
# RATE_LIMIT_PER_HOUR=50         # per caller identity, held in memory
# CONTEXT_TOKEN_BUDGET=10000     # how much source material reaches the model
# LOG_LEVEL=INFO
# LOG_FORMAT=plain               # or `json` for a log aggregator
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/brady_copilot
# JWT_SECRET_KEY=change-this-secret-in-production

# ---------------------------------------------------------------------------
# Two traps worth knowing before you debug an auth failure:
#
#   1. A stale OPENAI_API_KEY exported in your SHELL silently overrides this
#      file — the process environment wins. If auth behaves strangely, run
#      with it explicitly cleared:
#          env -u OPENAI_API_KEY -u OPENAI_BASE_URL python3 -m uvicorn ...
#
#   2. This file is looked up RELATIVE TO THE WORKING DIRECTORY. Start the
#      backend from inside `backend/`, or it will not be found — and, worse,
#      if a key happens to be exported the process starts anyway with its
#      methodology rules missing. See docs/SETUP.md.
# ---------------------------------------------------------------------------
